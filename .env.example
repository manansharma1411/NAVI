# ==============================================================================
# NAVI (Neural Autonomous Web Intelligence) - Environment Configuration Template
# NOTE: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and supply actual values for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# WebSocket Bridge (Extension <-> Backend Communication)
WS_HOST=0.0.0.0
WS_PORT=8001

# Frontend Dashboard
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8001

# AI / LLM Model Providers
# Provide the relevant API key(s) for the planning and perception engine
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Extension Configuration
EXTENSION_CLIENT_ID=your_extension_id_here

# Security & Authentication (if applicable)
JWT_SECRET=your_jwt_secret_token_here
SESSION_SECRET=your_session_secret_key_here

# ==============================================================================
# NAVI Frontend Environment Variables Template
# ==============================================================================

# Local Development Configuration
# Copy this file to .env.local for local development with Vite:
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8001
VITE_APP_ENV=development

# Production Deployment Configuration (Set these in Vercel Project Settings)
# VITE_API_BASE_URL=https://navi-backend.onrender.com
# VITE_WS_BASE_URL=wss://navi-backend.onrender.com/ws
# VITE_APP_ENV=production

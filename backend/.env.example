# NAVI Backend Environment Variables Template
# Copy to .env for local development

# Runtime Environment (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Network Binding (In Render, PORT is automatically injected by the platform)
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated origins for web dashboard & extensions)
# In production on Render, set this to your Vercel deployment URL:
# e.g. CORS_ORIGINS=https://navi-your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional single frontend URL shortcut
FRONTEND_URL=http://localhost:3000

# AI Model Provider API Keys (for planning & reasoning in subsequent phases)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

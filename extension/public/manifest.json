{
  "manifest_version": 3,
  "name": "NAVI — Neural Autonomous Web Intelligence",
  "version": "0.1.0",
  "description": "AI-powered universal browser agent extension for NAVI.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "NAVI Agent Side Panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
